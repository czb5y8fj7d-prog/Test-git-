# Port d'écoute du serveur
PORT=3000

# Secret utilisé pour signer les cookies de session admin (change cette valeur en prod)
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Identifiants du premier compte admin, utilisés uniquement lors de la toute
# première initialisation de la base de données (fichier data/boucherie.db).
# Une fois la base créée, change le mot de passe depuis le menu admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi
