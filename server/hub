#!/usr/bin/env bash
# hub — gère les projets du site : un dossier + un chemin (/nom/) par projet.
#
#   hub sync [branche]    publie tous les sites statiques décrits dans projects.json (branche « sites »)
#   hub add <nom> [--titre T] [--desc D] [--icone 🙂] [--categorie C] [--rang N] [--branche B] [--dossier D] [--depot URL]
#   hub update            met à jour le hub et tous les projets (git pull)
#   hub list              liste les projets publiés
#   hub remove <nom>      retire un projet du site (les fichiers sont conservés)
#
# Organisation sur le serveur :
#   /var/www/hub/              la page d'accueil (branche « hub »)           -> https://domaine/
#   /var/www/projects/<nom>/   un projet (une branche du dépôt)               -> https://domaine/<nom>/
#   /var/www/projects/_sites/  la branche « sites » (un dossier par projet)   -> https://domaine/<nom>/
#   /etc/caddy/projects/       un petit fichier Caddy par projet (le « routage »)
#   /var/lib/hub/projects.json la liste des boutons de l'accueil
set -e
if [ "${SUDO+x}" != x ]; then if [ "$(id -u)" = 0 ]; then SUDO=""; else SUDO="sudo"; fi; fi
HUB_DIR="${HUB_DIR:-/var/www/hub}"
PROJ_DIR="${PROJ_DIR:-/var/www/projects}"
SNIP_DIR="${SNIP_DIR:-/etc/caddy/projects}"
DATA_DIR="${DATA_DIR:-/var/lib/hub}"
CADDYFILE="${CADDYFILE:-/etc/caddy/Caddyfile}"
CADDY_BIN="${CADDY_BIN:-caddy}"
CADDY_RELOAD="${CADDY_RELOAD:-systemctl reload caddy}"
DEFAULT_REPO="${REPO_URL:-https://github.com/czb5y8fj7d-prog/test-git-}"
SLUG_RE='^[a-z0-9][a-z0-9-]{0,30}$'

die() { echo "Erreur : $*" >&2; exit 1; }

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; }

check_slug() {
  [[ "$1" =~ $SLUG_RE ]] || die "le nom « $1 » doit être en minuscules, chiffres et tirets (ex. : mon-projet)"
  case "$1" in api|v1|hub|server|projects|projects.json|robots.txt) die "« $1 » est réservé, choisissez un autre nom" ;; esac
}

# git clone ou pull d'une branche dans un dossier
fetch_branch() { # dossier dépôt branche
  if [ -d "$1/.git" ]; then
    $SUDO git -C "$1" pull --ff-only
  else
    $SUDO mkdir -p "$(dirname "$1")"
    $SUDO git clone --depth 1 --branch "$3" --single-branch "$2" "$1" \
      || die "impossible de récupérer la branche « $3 » de $2 (elle existe sur GitHub ?)"
  fi
  $SUDO chmod -R a+rX "$1"
}

# Publie un projet : routage Caddy + bouton sur l'accueil (ne recharge pas Caddy)
publish() { # nom dossier-servi titre desc icône catégorie [rang]
  local slug="$1" root="$2" title="$3" desc="$4" icon="$5" cat="$6" rank="${7:-}"
  [ -f "$root/index.html" ] || [ -f "$root/index.php" ] || die "« $root » ne contient pas de index.html"
  $SUDO mkdir -p "$SNIP_DIR"
  local snip="$SNIP_DIR/$slug.caddy"
  [ ! -e "$snip" ] || $SUDO cp "$snip" "$snip.bak"
  $SUDO tee "$snip" >/dev/null <<SNIP
redir /$slug /$slug/ 308
handle_path /$slug/* {
  root * $root
  encode gzip
  header Cache-Control "no-cache"
  file_server {
    hide .git server
  }
}
SNIP
  if ! $SUDO "$CADDY_BIN" validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1; then
    if [ -e "$snip.bak" ]; then $SUDO mv "$snip.bak" "$snip"; else $SUDO rm -f "$snip"; fi
    $SUDO "$CADDY_BIN" validate --config "$CADDYFILE" --adapter caddyfile || true
    die "la configuration Caddy est refusée ; « $slug » n'a pas été publié"
  fi
  $SUDO rm -f "$snip.bak"

  $SUDO mkdir -p "$DATA_DIR"
  $SUDO python3 - "$DATA_DIR/projects.json" "$slug" "$title" "$desc" "$icon" "$cat" "$rank" "${HUB_FORCE:-0}" <<'PY'
import json, sys
f, slug, title, desc, icon, cat, rank, force = sys.argv[1:9]
try:
    data = json.load(open(f))
    if not isinstance(data, list):
        data = []
except Exception:
    data = []
old = next((p for p in data if p.get("slug") == slug), {})
if old.get("edited") and force != "1":
    # modifié depuis le menu admin de l'accueil : « hub sync » / « hub update » ne l'écrasent pas
    sys.exit(0)
entry = {
    "slug": slug,
    "title": title or old.get("title") or slug,
    "desc": desc or old.get("desc") or "",
    "icon": icon or old.get("icon") or "📁",
    "cat": cat or old.get("cat") or "Projets",
    "path": "/" + slug + "/",
}
try:
    r = int(rank) if rank else old.get("order")
except ValueError:
    r = old.get("order")
if r is not None:
    entry["order"] = r
if any(p.get("slug") == slug for p in data):
    data = [entry if p.get("slug") == slug else p for p in data]
else:
    data.append(entry)
# ordre d'affichage : « order » croissant, les projets sans rang à la suite (ordre d'ajout conservé)
data = [p for _, p in sorted(enumerate(data), key=lambda t: (t[1].get("order", 10**6), t[0]))]
with open(f, "w", encoding="utf-8") as out:
    json.dump(data, out, ensure_ascii=False, indent=2)
PY
  $SUDO chmod 644 "$DATA_DIR/projects.json"
  $SUDO chmod 755 "$DATA_DIR"
  echo "   ✓ /$slug/"
}

cmd_add() {
  [ -n "$1" ] || die "il manque le nom du projet. Exemple : hub add llm --titre \"LocalLM\""
  local slug="$1"; shift
  local title="" desc="" icon="" cat="" rank="" branch="$slug" repo="$DEFAULT_REPO" sub=""
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || die "l'option $1 attend une valeur"
    case "$1" in
      --titre) title="$2" ;;
      --desc) desc="$2" ;;
      --icone) icon="$2" ;;
      --categorie) cat="$2" ;;
      --rang) rank="$2" ;;
      --branche) branch="$2" ;;
      --dossier) sub="$2" ;;
      --depot) repo="$2" ;;
      *) die "option inconnue : $1" ;;
    esac
    shift 2
  done
  check_slug "$slug"
  case "$sub" in /*|*..*) die "--dossier doit être un chemin relatif simple" ;; esac
  local dir="$PROJ_DIR/$slug"
  echo "→ Projet « $slug » (branche $branch)…"
  fetch_branch "$dir" "$repo" "$branch"
  local root="$dir"; [ -z "$sub" ] || root="$dir/$sub"
  HUB_FORCE=1 publish "$slug" "$root" "$title" "$desc" "$icon" "$cat" "$rank"
  $SUDO $CADDY_RELOAD
  echo "OK : le projet est en ligne sur /$slug/"
}

cmd_sync() {
  local branch="${1:-sites}" dir="$PROJ_DIR/_sites"
  echo "→ Branche « $branch »…"
  fetch_branch "$dir" "$DEFAULT_REPO" "$branch"
  [ -r "$dir/projects.json" ] || die "pas de projects.json à la racine de la branche « $branch »"
  python3 - "$dir/projects.json" > "${TMPDIR:-/tmp}/hub-sync.$$" <<'PY'
import json, re, sys
for p in json.load(open(sys.argv[1])):
    slug = p.get("slug", "")
    if not re.match(r"^[a-z0-9][a-z0-9-]{0,30}$", slug):
        sys.exit("slug invalide dans projects.json : %r" % slug)
    d = p.get("dir") or slug
    if d.startswith("/") or ".." in d:
        sys.exit("dossier invalide pour %s : %r" % (slug, d))
    print("\t".join([slug, d, p.get("title", ""), p.get("desc", ""), p.get("icon", ""), p.get("cat", ""), str(p.get("order", ""))]))
PY
  local n=0 slug sub title desc icon cat rank
  while IFS=$'\t' read -r -u 3 slug sub title desc icon cat rank; do
    check_slug "$slug"
    publish "$slug" "$dir/$sub" "$title" "$desc" "$icon" "$cat" "$rank"
    n=$((n + 1))
  done 3< "${TMPDIR:-/tmp}/hub-sync.$$"
  rm -f "${TMPDIR:-/tmp}/hub-sync.$$"
  $SUDO $CADDY_RELOAD
  echo "OK : $n projet(s) publié(s)"
}

cmd_update() {
  if [ -d "$HUB_DIR/.git" ]; then echo "→ hub"; $SUDO git -C "$HUB_DIR" pull --ff-only; fi
  for d in "$PROJ_DIR"/*/; do
    [ -d "$d.git" ] || continue
    echo "→ $(basename "$d")"
    $SUDO git -C "$d" pull --ff-only
  done
  $SUDO chmod -R a+rX "$HUB_DIR" "$PROJ_DIR" 2>/dev/null || true
  if [ -d "$PROJ_DIR/_sites/.git" ]; then cmd_sync; fi
  echo "OK : tout est à jour"
}

cmd_list() {
  [ -r "$DATA_DIR/projects.json" ] || { echo "Aucun projet."; return; }
  python3 - "$DATA_DIR/projects.json" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
if not data:
    print("Aucun projet.")
for p in data:
    print("%s  /%s/  %s  [%s]" % (p.get("icon", ""), p["slug"], p.get("title", ""), p.get("cat", "")))
PY
}

cmd_remove() {
  [ -n "$1" ] || die "il manque le nom du projet. Exemple : hub remove llm"
  local slug="$1"
  [[ "$slug" =~ $SLUG_RE ]] || die "nom invalide"
  $SUDO rm -f "$SNIP_DIR/$slug.caddy"
  if [ -r "$DATA_DIR/projects.json" ]; then
    $SUDO python3 - "$DATA_DIR/projects.json" "$slug" <<'PY'
import json, sys
f, slug = sys.argv[1:3]
data = [p for p in json.load(open(f)) if p.get("slug") != slug]
with open(f, "w", encoding="utf-8") as out:
    json.dump(data, out, ensure_ascii=False, indent=2)
PY
  fi
  $SUDO $CADDY_RELOAD
  echo "OK : « $slug » n'est plus publié (ses fichiers restent sur le serveur)."
  echo "     Attention : un projet de la branche « sites » est republié par « hub sync » tant qu'il est dans projects.json."
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  update) cmd_update ;;
  list) cmd_list ;;
  remove) shift; cmd_remove "$@" ;;
  *) usage ;;
esac
